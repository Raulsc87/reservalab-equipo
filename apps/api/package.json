    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "0.31.11",
